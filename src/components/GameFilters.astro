---
/**
 * Renders accessible category and publisher filters for the prerendered catalog.
 */
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<section
    aria-labelledby="game-filters-heading"
    data-testid="game-filters"
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-6"
>
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="flex-1">
            <h2 id="game-filters-heading" class="mb-4 text-xl font-medium text-slate-100">Filter games</h2>

            <fieldset>
                <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                    {categories.map((category) => (
                        <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                            <input
                                type="checkbox"
                                value={category.id}
                                data-filter-category
                                data-testid={`category-filter-${category.id}`}
                                class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                            />
                            <span>{category.name}</span>
                        </label>
                    ))}
                </div>
            </fieldset>
        </div>

        <div class="flex flex-col gap-2 lg:min-w-64">
            <label for="publisher-filter" class="text-sm font-medium text-slate-200">Publisher</label>
            <select
                id="publisher-filter"
                data-filter-publisher
                data-testid="publisher-filter"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
            <button
                type="button"
                data-filter-reset
                data-testid="reset-filters"
                class="self-start rounded-lg px-3 py-2 text-sm font-medium text-blue-300 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
                Clear filters
            </button>
        </div>
    </div>

    <p data-filter-status data-testid="filter-status" class="mt-4 text-sm text-slate-400" role="status" aria-live="polite"></p>
</section>

<script>
    const filterRoot = document.querySelector<HTMLElement>('[data-testid="game-filters"]');

    if (filterRoot) {
        const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
        const categoryInputs = Array.from(filterRoot.querySelectorAll<HTMLInputElement>('[data-filter-category]'));
        const publisherSelect = filterRoot.querySelector<HTMLSelectElement>('[data-filter-publisher]');
        const resetButton = filterRoot.querySelector<HTMLButtonElement>('[data-filter-reset]');
        const status = filterRoot.querySelector<HTMLElement>('[data-filter-status]');
        const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

        const applyFilters = (): void => {
            const selectedCategories = new Set(
                categoryInputs.filter((input) => input.checked).map((input) => input.value),
            );
            const selectedPublisher = publisherSelect?.value ?? '';
            let visibleCount = 0;

            for (const card of cards) {
                const categoryMatches =
                    selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
                const publisherMatches =
                    selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
                const matches = categoryMatches && publisherMatches;

                card.hidden = !matches;
                if (matches) visibleCount++;
            }

            if (emptyState) {
                emptyState.hidden = visibleCount > 0;
                emptyState.classList.toggle('hidden', visibleCount > 0);
            }
            if (status) status.textContent = `Showing ${visibleCount} of ${cards.length} games.`;
        };

        for (const input of categoryInputs) input.addEventListener('change', applyFilters);
        publisherSelect?.addEventListener('change', applyFilters);
        resetButton?.addEventListener('click', () => {
            for (const input of categoryInputs) input.checked = false;
            if (publisherSelect) publisherSelect.value = '';
            applyFilters();
        });

        applyFilters();
    }
</script>
